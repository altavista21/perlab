rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAgent() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'citizen'
        && request.resource.data.createdAt == request.time;
      allow list, update, delete: if false;
    }

    match /applications/{applicationId} {
      // Citizens can query only their own applications; agents can review the queue.
      allow get: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAgent());
      allow list: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAgent());

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'applicantName', 'applicantEmail', 'programs', 'dayaListrik',
          'motorCount', 'carCount', 'hasSchoolMember', 'hasElderlyMember',
          'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid', 'applicantName', 'applicantEmail', 'programs', 'dayaListrik',
          'motorCount', 'carCount', 'hasSchoolMember', 'hasElderlyMember',
          'status', 'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.applicantName is string
        && request.resource.data.applicantName.size() >= 1
        && request.resource.data.applicantName.size() <= 80
        && request.resource.data.applicantEmail == request.auth.token.email
        && request.resource.data.programs is list
        && request.resource.data.programs.size() >= 1
        && request.resource.data.programs.size() <= 7
        && request.resource.data.programs.toSet().hasOnly([
          'BPNT', 'PKH', 'KIP', 'SUBSIDI_LISTRIK', 'SUBSIDI_BBM', 'SUBSIDI_GAS', 'LANSIA'
        ])
        && request.resource.data.dayaListrik in ['450 VA', '900 VA', '1300 VA', '2200 VA', '> 2200 VA']
        && request.resource.data.motorCount is int
        && request.resource.data.motorCount >= 0
        && request.resource.data.motorCount <= 99
        && request.resource.data.carCount is int
        && request.resource.data.carCount >= 0
        && request.resource.data.carCount <= 99
        && request.resource.data.hasSchoolMember is bool
        && request.resource.data.hasElderlyMember is bool
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update: if isAgent()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewNote', 'reviewedBy', 'reviewedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll([
          'status', 'reviewNote', 'reviewedBy', 'reviewedAt'
        ])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewNote is string
        && request.resource.data.reviewNote.size() >= 10
        && request.resource.data.reviewNote.size() <= 1000
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;

      allow delete: if false;
    }

    match /appeals/{appealId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
