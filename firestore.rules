rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Profile documents are provisioned by an administrator, not by clients.
    // Users can read only their own profile to resolve their assigned role.
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Application and appeal data remain closed until dedicated, tested rules
    // and server-authorized workflows are implemented.
    match /applications/{documentId} {
      allow read, write: if false;
    }

    match /appeals/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
