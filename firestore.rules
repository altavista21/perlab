rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;

      // Public registration may create only a citizen profile for its own UID.
      // Clients can never assign themselves the agent role or edit roles later.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'citizen'
        && request.resource.data.createdAt == request.time;

      allow list, update, delete: if false;
    }

    // Application and appeal data remain closed until dedicated, tested rules
    // and server-authorized workflows are implemented.
    match /applications/{documentId} {
      allow read, write: if false;
    }

    match /appeals/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}